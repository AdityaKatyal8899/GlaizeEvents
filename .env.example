# ==============================================================================
# GLAIZ EVENTS ATELIER — Environment Configuration
# ==============================================================================

# 1. MongoDB Database Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/glaiz_events?retryWrites=true&w=majority
MONGODB_URI=

# 2. Discord Webhook URL for Instant Lead & Booking Embed Alerts
# Create in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
# Example: https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz
DISCORD_WEBHOOK_URL=

# 3. SMTP Email Configuration (Nodemailer - Gmail / Custom Domain / Zoho / Outlook)
# For Gmail: Use a 16-character Google App Password (My Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Glaizevents@gmail.com
SMTP_PASS=
SMTP_SECURE=true

# 4. Optional: Resend API Key (Alternative HTTP email provider)
# Get your API key at: https://resend.com
RESEND_API_KEY=

# 5. Verified Sender & Studio Notification Email
EMAIL_FROM="Glaiz Events <Glaizevents@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="Glaizevents@gmail.com"
